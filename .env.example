# Shared upstream URL used by every module unless a module-specific value exists.
ITEM_API_BASE_URL=https://api.example.com

# Module-specific URL example. The module name is normalized to uppercase snake case.
ITEM_API_TRIP_DISPATCH_BASE_URL=https://dispatch-api.example.com

# Development only: permit browser-configured base URLs that resolve to private networks.
# Never enable this for an internet-facing deployment.
ITEM_API_ALLOW_PRIVATE_HOSTS=false

# Authentication variables are only used when the OpenAPI contract declares a supported scheme.
# The supplied contract declares security: [] for every operation, so these are intentionally unset.
# ITEM_API_TRIP_DISPATCH_BEARER_TOKEN=replace-on-server
# ITEM_API_TRIP_DISPATCH_API_KEY=replace-on-server
# ITEM_API_TRIP_DISPATCH_BASIC_USERNAME=replace-on-server
# ITEM_API_TRIP_DISPATCH_BASIC_PASSWORD=replace-on-server
